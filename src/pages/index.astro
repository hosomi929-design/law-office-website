---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
const areas = [
  { name: '企業法務・顧問契約', body: '契約書の作成・チェック、労務、債権回収など、日常の法務をサポートします。' },
  { name: '事業承継・M&A', body: '株式の評価や税務の論点も含め、承継の計画づくりから契約まで対応します。' },
  { name: '相続・遺言', body: '遺産分割の交渉、遺言書の作成など相続問題への対策をご提案します。' },
  { name: '離婚・男女関係問題', body: '財産分与や養育費など、お金の整理も含めて丁寧にお話を伺います。' },
  { name: '債務整理・破産・再生', body: '個人・法人の事業再生・生活再建に向けて、最適な手続きをご案内します。' },
  { name: '会計・財務に関わる紛争', body: '不正会計、株主間のトラブルなど、会計の知識が必要な案件に対応します。' },
];
---
<Layout>
  <Hero />

  <section class="section" id="strength">
    <div class="wrap">
      <h2>法律と会計、両方の資格を持つ事務所です</h2>
      <p class="lead">石川県内で唯一、弁護士と公認会計士の資格を併せ持つ事務所です。法的知識を踏まえた会計的判断、会計的知識を踏まえた法的判断をご提供いたします。</p>
      <div class="two">
        <div><h3>弁護士として</h3><p>交渉・訴訟など、トラブル発生時の法的手続を実施する他、契約書の作成等トラブルの防止のための業務を行います。</p></div>
        <div><h3>公認会計士として</h3><p>決算書の分析、企業価値や財産評価を踏まえたアドバイス行います。</p></div>
      </div>
    </div>
  </section>

  <section class="section tint" id="practice">
    <div class="wrap">
      <h2>取扱分野</h2>
      <p class="lead">ここに挙げた以外のご相談もお受けします。まずはお問い合わせください。</p>
      <dl class="areas">
        {areas.map((a) => (<><dt>{a.name}</dt><dd>{a.body}</dd></>))}
      </dl>
    </div>
  </section>

  <section class="section" id="lawyer">
    <div class="wrap">
      <h2>弁護士・公認会計士　細見孝次</h2>
      <p class="lead">弁護士として25年、公認会計士として10年以上の実務経験があります。倒産・事業再生、企業の監査、M&Aのデューデリジェンスなど、法律と会計が重なる分野を得意としています。</p>
      <a class="more" href="/lawyer">経歴・業務実績を見る</a>
    </div>
  </section>

  <section class="section tint" id="contact">
    <div class="wrap">
      <h2>アクセス・ご相談</h2>
      <p class="lead">初回のご相談方法や料金はお電話でご案内します。なお、繁忙期等は新規のご相談をお受けできない場合がありますので、あしからずご了承下さい。</p>
      <table>
        <tbody>
          <tr><th>事務所</th><td>ネクスト法律事務所／細見公認会計士事務所<br />〒920-0902 石川県金沢市尾張町1丁目2-23 プチハイム尾張町1階</td></tr>
          <tr><th>電話</th><td><a href="tel:0762616670">076-261-6670</a></td></tr>
          <tr><th>受付時間</th><td>平日 9:00〜17:00</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  .more { display: inline-block; padding: 10px 28px; border: 1px solid var(--navy); color: var(--navy); text-decoration: none; font-size: .9rem; }
  .more:hover { background: var(--navy); color: #fff; }
  h3 { font-family: var(--serif); color: var(--wood); margin: 0 0 4px; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
  .areas { display: grid; grid-template-columns: 14em 1fr; margin: 0; border-top: 1px solid #cfd3dc; }
  .areas dt, .areas dd { margin: 0; padding: 18px 0; border-bottom: 1px solid #cfd3dc; }
  .areas dt { font-weight: 700; color: var(--navy); }
  .profile { display: grid; grid-template-columns: 240px 1fr; gap: 48px; align-items: start; }
  .photo { aspect-ratio: 3 / 4; background: #dfe3ea; display: grid; place-items: center; color: #7b8396; }
  table { border-collapse: collapse; width: 100%; max-width: 640px; }
  th, td { text-align: left; padding: 12px 16px 12px 0; border-bottom: 1px solid #cfd3dc; vertical-align: top; }
  th { width: 7em; color: var(--wood); font-weight: 700; }
  @media (max-width: 720px) {
    .areas { grid-template-columns: 1fr; }
    .areas dt { border-bottom: 0; padding-bottom: 0; }
    .profile { grid-template-columns: 1fr; gap: 24px; }
    .photo { max-width: 200px; }
  }
</style>
