---
import Header from '../components/Header.astro';
const { title = 'ネクスト法律事務所｜弁護士・公認会計士 細見孝次（石川県金沢市）', description = '石川県内唯一の弁護士・公認会計士ダブルライセンス。法律と会計の両面から、ご相談に対応します。' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <footer class="footer">
      <p>ネクスト法律事務所 ／ 細見公認会計士事務所<br />〒920-0902 石川県金沢市尾張町1丁目2-23 プチハイム尾張町1階</p><p class="copy">© ネクスト法律事務所</p>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --navy: #14213a;
    --wood: #5a3a26;
    --gold: #a8803f;
    --paper: #f4f5f7;
    --ink: #1d2433;
    --serif: 'Noto Serif JP', 'Hiragino Mincho ProN', serif;
    --sans: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 72px; }
  body { margin: 0; font-family: var(--sans); color: var(--ink); background: #fff; line-height: 1.9; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 88px 0; }
  .section.tint { background: var(--paper); }
  h2 { font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2rem); color: var(--navy); margin: 0 0 12px; border-left: 4px solid var(--gold); padding-left: 16px; line-height: 1.4; }
  .lead { max-width: 40em; margin: 0 0 40px; }
  .footer { background: var(--navy); color: #cfd5e2; text-align: center; padding: 28px 24px; font-size: .85rem; }
  .footer p { margin: 0; line-height: 1.8; }
  .footer .copy { margin-top: 8px; font-size: .75rem; opacity: .7; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
